# ============================================================
# 复制为 .env.local 后填写真实值。切勿提交 .env.local 到仓库。
# 未配置 Supabase 时站点自动降级为 demo 模式（使用 lib/data.ts 兜底数据）。
# ============================================================

# ---------- Supabase（数据库） ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
# 服务端专用，务必不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- 后台口令（/admin 读取 leads、导出 CSV） ----------
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------- 邮件通知（Resend） ----------
# 官方服务邮箱：service@jinyoudata.com（腾讯企业邮箱，全站展示地址见 lib/brand.ts）
# 用 service@jinyoudata.com 作为 From 之前，需在 Resend 验证 jinyoudata.com 发信域名
# （腾讯企业邮箱的 MX 保持不变，只追加 Resend 的 SPF / DKIM TXT 记录）
RESEND_API_KEY=re_xxxxxx
RESEND_FROM_EMAIL="汽配知识局 <service@jinyoudata.com>"
LEAD_NOTIFY_EMAIL=service@jinyoudata.com

# ---------- 飞书机器人通知 ----------
# 群设置 → 群机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx

# ---------- AI 问答（后端代理，前端不暴露密钥） ----------
# 不配置时 /api/ai 走关键词兜底回复，功能仍可用
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------- 站点信息（canonical / OG / sitemap / robots 都依赖它） ----------
# Cloudflare Pages 部署时在控制台 Settings > Environment variables 里配置
# 必须是构建时就存在（NEXT_PUBLIC_ 前缀会被打进静态 HTML），改完要重新部署
NEXT_PUBLIC_SITE_URL=https://jinyoudata.com

# ---------- 数据分析（二选一或同时配，都不配则不注入任何脚本） ----------
# GA4：衡量 ID，形如 G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Plausible：域名 + 自建实例地址（默认官方 https://plausible.io）
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
# Plausible 自定义事件名（后台建 goal 时用同一套）：
#   form_submit / wechat_click / third_party_click / asset_download / consult_click
# GA4 事件名同理，可直接在「管理 → 事件」里看到。

# ============================================================
# 购买与交付：官网留资 → 第三方平台（小鹅通 / 知识星球）成交与交付
# 官网不收钱、不碰支付，因此不需要任何支付密钥。
# 第三方成交链接填在数据库 products.external_url（见 0006_external_url.sql）
# ============================================================

# ============================================================
# Cloudflare Pages 专用（以下变量全部在控制台填，不要提交进仓库）
# Settings > Environment variables，Production / Preview 各填一份
# ------------------------------------------------------------
# 构建系统变量
NODE_VERSION=20
#
# 必填（站点地址 + 数据库）
# NEXT_PUBLIC_SITE_URL=https://jinyoudata.com
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   ← 点 Encrypt 存成密文
# ADMIN_TOKEN=长随机字符串                   ← 点 Encrypt 存成密文
#
# 选填（不填不影响访问，只是关闭对应功能）
# RESEND_API_KEY / RESEND_FROM_EMAIL / LEAD_NOTIFY_EMAIL
# FEISHU_WEBHOOK_URL
# AI_API_KEY / AI_BASE_URL / AI_MODEL
# NEXT_PUBLIC_GA4_ID / NEXT_PUBLIC_PLAUSIBLE_DOMAIN
#
# 注意：next-on-pages 只支持 Edge Runtime，本项目所有 app/api/**/route.ts
# 已统一声明 export const runtime = "edge"；新增接口时也要加这一行。
# ============================================================

